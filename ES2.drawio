<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.2.2 Chrome/134.0.6998.178 Electron/35.1.2 Safari/537.36" version="26.2.2">
  <diagram name="Page-1" id="u8eFSOzxFuC2Vz6_twsS">
    <mxGraphModel dx="4023" dy="4087" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml \&quot;Password Manager Class Diagram\&quot;\n\n&#39; Styling\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam packageStyle rectangle\n\n&#39; Package: Interfaces\npackage \&quot;Interfaces\&quot; {\n  enum PasswordType {\n    STANDART\n    STRONG\n  }\n  \n  interface PasswordCategory {\n    +show(): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n  }\n  \n  interface Passwords {\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n  }\n  \n  interface StorageStrategy {\n    +getPassword(id: String): String\n    +savePassword(password: Passwords): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    +restoreState(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category): void\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n}\n\n&#39; Package: Factory\npackage \&quot;Factory\&quot; {\n  abstract class FactoryPassword {\n    -registry: Map&lt;PasswordType, Supplier&lt;? extends Passwords&gt;&gt;\n    +{static} makePassword(type: PasswordType): Passwords\n  }\n  \n  class Standart {\n    -password: String\n    -type: PasswordType\n    -name: String\n    -username: String\n    +Standart()\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n    -generateStandartPassword(): String\n    +saveToDb(): void\n  }\n  \n  class Strong {\n    -password: String\n    -type: PasswordType\n    -username: String\n    -name: String\n    +Strong()\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n    -generateStrongPassword(): String\n    +saveToDb(): void\n    +{static} displayAllPasswords(passwords: LinkedHashMap&lt;String, Passwords&gt;): void\n  }\n}\n\n&#39; Package: Composite\npackage \&quot;Composite\&quot; {\n  class Category {\n    -name: String\n    -children: List&lt;PasswordCategory&gt;\n    -passwordIds: List&lt;String&gt;\n    +Category(name: String)\n    +getName(): String\n    +getChildren(): List&lt;PasswordCategory&gt;\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +show(): void\n    +addPasswordId(passwordId: String): void\n    +getPasswordIds(): List&lt;String&gt;\n  }\n  \n  class PasswordGenerator {\n    +{static} generatePassword(length: int, includeUppercase: boolean, includeDigits: boolean, includeSpecial: boolean): String\n  }\n}\n\n&#39; Package: Strategy\npackage \&quot;Strategy\&quot; {\n  abstract class AbstractStorageStrategy {\n    #passwordCache: LinkedHashMap&lt;String, Passwords&gt;\n    #rootCategory: Category\n    +AbstractStorageStrategy()\n    #cleanupNullPasswords(): void\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n  }\n  \n  class FileStorageStrategy {\n    -masterPassword: String\n    -passwordsFilePath: String\n    -categoriesFilePath: String\n    +FileStorageStrategy(masterPassword: String)\n    +getPassword(id: String): String\n    +savePassword(password: Passwords): String\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    +restoreState(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category): void\n    +loadDataWithMasterPassword(masterPassword: String): void\n    -writeToFile(filePath: String, content: String): void\n    -readFromFile(filePath: String): String\n    -serializePasswords(): String\n    -deserializePasswords(serialized: String): void\n    -serializeCategories(): String\n    -deserializeCategories(serialized: String): void\n    +cleanupCategoryReferences(): void\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n  \n  class PostgresStorageStrategy {\n    -connectionString: String\n    -username: String\n    -password: String\n    +PostgresStorageStrategy(connectionString: String, username: String, password: String)\n    +getPassword(id: String): String\n    +savePassword(password: Passwords): String\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    -loadFromDatabase(): void\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n  \n  class StorageAPI {\n    -storageStrategy: StorageStrategy\n    -careTaker: PasswordManagerCareTaker\n    +StorageAPI(masterPassword: String)\n    +setMasterPassword(masterPassword: String): void\n    +getStorageStrategy(): StorageStrategy\n    +getPassword(id: String): String\n    +savePassword(password: Passwords): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    +restoreState(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category): void\n    +displayCategoryHierarchy(): void\n    +getCaretaker(): PasswordManagerCareTaker\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n}\n\n&#39; Package: Decorator\npackage \&quot;Decorator\&quot; {\n  abstract class StorageDecorator {\n    #storageStrategy: StorageStrategy\n    +StorageDecorator(storageStrategy: StorageStrategy)\n    +getPassword(id: String): String\n    +savePassword(password: Passwords): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    +restoreState(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category): void\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n  \n  class MFAStorageDecorator {\n    -random: Random\n    -lastGeneratedCode: String\n    +MFAStorageDecorator(storageStrategy: StorageStrategy)\n    +savePassword(password: Passwords): String\n    +getPassword(id: String): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    -authenticateMFA(): boolean\n    +addPasswordToCategory(categoryPath: String, password: Passwords): void\n    +saveState(): void\n    +restoreState(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category): void\n    +PasswordCategory(passwordId: String): String\n    +savePasswordWithCategory(password: Passwords, categoryPath: String): String\n  }\n}\n\n&#39; Package: Singleton\npackage \&quot;Singleton\&quot; {\n  class ConfigurationManager {\n    -instance: ConfigurationManager\n    -configuration: HashMap&lt;String, String&gt;\n    +{static} getConfigurationManager(): ConfigurationManager\n    +getConnectionString(key: String): String\n    +setConnectionString(key: String, value: String): void\n  }\n}\n\n&#39; Package: Memento\npackage \&quot;Memento\&quot; {\n  class PasswordManagerMemento {\n    -passwords: LinkedHashMap&lt;String, Passwords&gt;\n    -rootCategory: Category\n    -timestamp: LocalDateTime\n    +PasswordManagerMemento(passwords: LinkedHashMap&lt;String, Passwords&gt;, rootCategory: Category)\n    +getPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    +getTimestamp(): LocalDateTime\n    -deepCopyPasswords(original: LinkedHashMap&lt;String, Passwords&gt;): LinkedHashMap&lt;String, Passwords&gt;\n    -deepCopyCategory(original: Category): Category\n  }\n  \n  class MementoOriginator {\n    -passwords: LinkedHashMap&lt;String, Passwords&gt;\n    -rootCategory: Category\n    +setStateFromAPI(storageStrategy: StorageStrategy): void\n    +createMemento(): PasswordManagerMemento\n    +restoreFromMemento(memento: PasswordManagerMemento): void\n  }\n}\n\n&#39; Main Class\nclass Main {\n  -{static} scanner: Scanner\n  +{static} main(args: String[]): void\n  -{static} readPasswordFromConsole(): String\n  -{static} showMainMenu(regularStorage: StorageAPI, secureStorage: MFAStorageDecorator): void\n  -{static} createPassword(scanner: Scanner, type: PasswordType): void\n  -{static} storePassword(regularStorage: StorageAPI, secureStorage: MFAStorageDecorator): void\n  -{static} retrievePassword(scanner: Scanner, storageAPI: StorageAPI): void\n  -{static} displayAllPasswords(storageAPI: StorageAPI): void\n  -{static} manageCategories(scanner: Scanner, regularStorage: StorageAPI, secureStorage: MFAStorageDecorator): void\n  -{static} restorePreviousState(scanner: Scanner, storageAPI: StorageAPI, memento: MementoOriginator): void\n  -{static} getIntInput(min: int, max: int): int\n  -{static} displayCategoryHierarchy(storageAPI: StorageAPI): void\n}\n\n&#39; Relationships - Implementations\nStandart ..|&gt; Passwords\nStandart ..|&gt; PasswordCategory\nStrong ..|&gt; Passwords\nStrong ..|&gt; PasswordCategory\nCategory ..|&gt; PasswordCategory\nAbstractStorageStrategy ..|&gt; StorageStrategy\nFileStorageStrategy --|&gt; AbstractStorageStrategy\nPostgresStorageStrategy --|&gt; AbstractStorageStrategy\nStorageDecorator ..|&gt; StorageStrategy\nMFAStorageDecorator --|&gt; StorageDecorator\n\n&#39; Relationships - Associations\nFactoryPassword ..&gt; Passwords : creates &gt;\nStorageAPI o-- StorageStrategy\nStorageDecorator o-- StorageStrategy\nCategory o-- PasswordCategory\nMain ..&gt; StorageAPI : uses &gt;\nMain ..&gt; MFAStorageDecorator : uses &gt;\nMain ..&gt; FactoryPassword : uses &gt;\nMementoOriginator ..&gt; PasswordManagerMemento : creates &gt;\n\n@startuml \&quot;Missing Classes\&quot;\n\n&#39; Package: Memento\npackage \&quot;Memento\&quot; {\n  class PasswordManagerCaretaker {\n    -mementos: List&lt;PasswordManagerMemento&gt;\n    -maxHistorySize: int\n    +PasswordManagerCaretaker(maxHistorySize: int)\n    +addMemento(memento: PasswordManagerMemento): void\n    +getMemento(index: int): PasswordManagerMemento\n    +getLastMemento(): PasswordManagerMemento\n    +getMementoCount(): int\n    +getMementoTimestamps(): List&lt;LocalDateTime&gt;\n  }\n}\n\n&#39; Package: ReusablePool\npackage \&quot;ReusablePool\&quot; {\n  class ReusablePool {\n    -instance: ReusablePool\n    -pool: ArrayList&lt;HttpURLConnection&gt;\n    -maxSize: int\n    -ReusablePool()\n    +{static} getInstance(): ReusablePool\n    +acquire(url: URL): HttpURLConnection\n    +release(conn: HttpURLConnection): void\n    +resetPool(): void\n    +setMaxPoolSize(size: int): void\n  }\n}\n\n&#39; Package: Composite\npackage \&quot;Composite\&quot; {\n  class PasswordGenerator {\n    +{static} generatePassword(length: int, includeUppercase: boolean, includeDigits: boolean, includeSpecial: boolean): String\n    +saveToDb(): void\n  }\n}\n\n&#39; Relationships\nPasswordManagerCaretaker o-- \&quot;0..*\&quot; PasswordManagerMemento: stores &gt;\nMementoOriginator ..&gt; PasswordManagerCaretaker: uses &gt;\nMain ..&gt; ReusablePool: uses &gt;\nStrong ..&gt; PasswordGenerator: uses &gt;\nStandart ..&gt; PasswordGenerator: uses &gt;\n\n@enduml\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="TAQO7KC3a_Kqlcrcfuz9-2">
