<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:136.0) Gecko/20100101 Firefox/136.0" version="26.2.2">
  <diagram name="Page-1" id="u8eFSOzxFuC2Vz6_twsS">
    <mxGraphModel dx="4893" dy="3190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml \&quot;Password Manager Updated Class Diagram\&quot;\n\n&#39; Styling\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam packageStyle rectangle\n\n&#39; Package: Interfaces\npackage \&quot;Interfaces\&quot; {\n  enum PasswordType {\n    STANDART\n    STRONG\n  }\n  \n  interface PasswordCategory {\n    +show(): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n  }\n  \n  interface Passwords {\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n  }\n  \n  interface StorageImplementation {\n    +getStorage(storageId: String): String\n    +setStorage(password: Passwords): String\n  }\n  \n  interface FileStorage {\n    +writeData(data: String): void\n    +readData(): String\n    +exists(): boolean\n    +create(): void\n    +delete(): void\n  }\n  \n  interface MementoOriginator {\n    +getSavedPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getSavedRootCategory(): Category\n    +getLastAccessedPasswordId(): String\n  }\n}\n\n&#39; Package: Factory\npackage \&quot;Factory\&quot; {\n  class FactoryPassword &lt;&lt; static &gt;&gt; {\n    -registry: Map&lt;PasswordType, Supplier&lt;? extends Passwords&gt;&gt;\n    +{static} makePassword(type: PasswordType): Passwords\n  }\n  \n  class Strong {\n    -password: String\n    -type: PasswordType\n    -username: String\n    -name: String\n    -dbConnection: ReusablePool\n    -dbUrl: URL\n    +Strong()\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n    -generateStrongPassword(): String\n    +saveToDb(): void\n  }\n  \n  class Standart {\n    -password: String\n    -type: PasswordType\n    -name: String\n    -username: String\n    -dbConnection: ReusablePool\n    -dbUrl: URL\n    +Standart()\n    +getPassword(): String\n    +setPassword(password: String): void\n    +getType(): PasswordType\n    +show(): void\n    +getName(): String\n    +setName(name: String): void\n    +getUsername(): String\n    +setUsername(username: String): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n    -generateStandartPassword(): String\n    +saveToDb(): void\n  }\n}\n\n&#39; Package: Adapter\npackage \&quot;Adapter\&quot; {\n  class StorageAPI {\n    -adapter: StorageAdapter\n    -lastAccessedPasswordId: String\n    -caretaker: PasswordManagerCaretaker\n    +StorageAPI(masterPassword: String)\n    +StorageAPI(masterPassword: String, loadStorage: boolean)\n    +createMemento(): PasswordManagerMemento\n    +restoreFromMemento(memento: PasswordManagerMemento): void\n    -saveState(): void\n    +getStorage(storageId: String): String\n    +setStorage(password: Passwords): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +setMasterPassword(password: String): void\n    +verifyMasterPassword(password: String): boolean\n    +getRootCategory(): Category\n    +addPasswordToCategory(path: String, pwd: Passwords): void\n    +displayCategoryHierarchy(): void\n    +getCaretaker(): PasswordManagerCaretaker\n  }\n  \n  class StorageAdapter {\n    -fileStorage: FileStorage\n    -encryptor: Encryptor\n    -storage: LinkedHashMap&lt;String, Passwords&gt;\n    -rootCategory: Category\n    -lastAccessedPasswordId: String\n    +StorageAdapter(fileStorage: FileStorage, masterPassword: String, loadStorage: boolean)\n    +StorageAdapter(fileStorage: FileStorage, masterPassword: String)\n    +getStorage(storageId: String): String\n    +setStorage(password: Passwords): String\n    +getAllPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getRootCategory(): Category\n    +addPasswordToCategory(path: String, pwd: Passwords): void\n    -findOrCreateCategoryPath(path: String): Category\n    -loadStorage(): void\n    -saveStorage(): void\n    -serializePasswords(): String\n    -serializeCategoryRecursive(category: PasswordCategory, path: String, builder: StringBuilder): void\n    -findPasswordId(password: Passwords): String\n    -deserializePasswords(data: String): void\n    +restoreState(savedPasswords: LinkedHashMap, savedRootCategory: Category): void\n  }\n  \n  class FileStorageImpl {\n    -filePath: String\n    +FileStorageImpl(filePath: String)\n    +writeData(data: String): void\n    +readData(): String\n    +exists(): boolean\n    +create(): void\n    +delete(): void\n  }\n  \n  class Encryptor {\n    -ENCRYPTION_ALGORITHM: String\n    -TRANSFORMATION: String\n    -KEY_LENGTH: int\n    -SALT_FILE_PATH: String\n    -IV_FILE_PATH: String\n    -SALT_LENGTH: int\n    -IV_LENGTH: int\n    -secretKey: SecretKey\n    -iv: IvParameterSpec\n    +Encryptor(masterPassword: String)\n    +encrypt(data: String): String\n    +decrypt(encryptedData: String): String\n    -generateKey(password: String): SecretKey\n    -getSalt(): byte[]\n    -getIV(): IvParameterSpec\n  }\n}\n\n&#39; Package: Composite\npackage \&quot;Composite\&quot; {\n  class Category {\n    -name: String\n    -children: List&lt;PasswordCategory&gt;\n    -dbConnection: ReusablePool\n    -dbUrl: URL\n    +Category(name: String)\n    +getName(): String\n    +show(): void\n    +add(category: PasswordCategory): void\n    +remove(category: PasswordCategory): void\n    +getChildren(): List&lt;PasswordCategory&gt;\n    +saveToDb(): void\n  }\n  \n  class PasswordGenerator &lt;&lt; static &gt;&gt; {\n    -UPPERCASE: String\n    -LOWERCASE: String\n    -DIGITS: String\n    -SPECIAL_CHARACTERS: String\n    -ALL_CHARACTERS: String\n    -random: SecureRandom\n    -dbConnection: ReusablePool\n    -dbUrl: URL\n    +{static} generatePassword(length: int): String\n    +{static} generatePassword(length: int, includeUppercase: boolean, includeDigits: boolean, includeSpecial: boolean): String\n    +saveToDb(): void\n  }\n}\n\n&#39; Package: Memento\npackage \&quot;Memento\&quot; {\n  class PasswordManagerMemento {\n    -passwordsState: LinkedHashMap&lt;String, Passwords&gt;\n    -rootCategoryState: Category\n    -lastAccessedPasswordId: String\n    -timestamp: LocalDateTime\n    +PasswordManagerMemento(passwords: LinkedHashMap, rootCategory: Category, lastAccessedPasswordId: String)\n    +getSavedPasswords(): LinkedHashMap&lt;String, Passwords&gt;\n    +getSavedRootCategory(): Category\n    +getLastAccessedPasswordId(): String\n    +getTimestamp(): LocalDateTime\n    -deepCopyCategory(original: Category): Category\n  }\n  \n  class PasswordManagerCaretaker {\n    -mementos: List&lt;PasswordManagerMemento&gt;\n    -maxHistorySize: int\n    +PasswordManagerCaretaker(maxHistorySize: int)\n    +addMemento(memento: PasswordManagerMemento): void\n    +getMemento(index: int): PasswordManagerMemento\n    +getLastMemento(): PasswordManagerMemento\n    +getMementoCount(): int\n    +getMementoTimestamps(): List&lt;LocalDateTime&gt;\n  }\n}\n\n&#39; Package: Singleton\npackage \&quot;Singleton\&quot; {\n  class AppInstance &lt;&lt; singleton &gt;&gt; {\n    -instance: AppInstance\n    -AppInstance()\n    +{static} getInstance(): AppInstance\n    +getConfigurationManager(): ConfigurationManager\n  }\n  \n  class ConfigurationManager {\n    -configuration: HashMap&lt;String, String&gt;\n    +getConnectionString(key: String): String\n    +setConnectionString(key: String, value: String): void\n  }\n  \n  class ConfigurationSingleton &lt;&lt; singleton &gt;&gt; {\n    -instance: ConfigurationManager\n    +{static} getConfigurationManager(): ConfigurationManager\n  }\n}\n\n&#39; Package: ReusablePool\npackage \&quot;ReusablePool\&quot; {\n  class ReusablePool &lt;&lt; singleton &gt;&gt; {\n    -instance: ReusablePool\n    -pool: ArrayList&lt;HttpURLConnection&gt;\n    -maxSize: int\n    -ReusablePool()\n    +{static} getInstance(): ReusablePool\n    +acquire(url: URL): HttpURLConnection\n    +release(conn: HttpURLConnection): void\n    +resetPool(): void\n    +setMaxPoolSize(size: int): void\n  }\n}\n\n&#39; Main class\nclass Main {\n  +{static} main(args: String[]): void\n  -{static} createPassword(scanner: Scanner, type: PasswordType): void\n  -{static} storePassword(scanner: Scanner, storageAPI: StorageAPI): void\n  -{static} retrievePassword(scanner: Scanner, storageAPI: StorageAPI): void\n  -{static} displayAllPasswords(storageAPI: StorageAPI): void\n  -{static} manageCategories(scanner: Scanner, storageAPI: StorageAPI): void\n  -{static} restorePreviousState(scanner: Scanner, storageAPI: StorageAPI): void\n}\n\n&#39; Class relationships\nStrong ..|&gt; Passwords\nStrong ..|&gt; PasswordCategory\nStandart ..|&gt; Passwords\nStandart ..|&gt; PasswordCategory\nCategory ..|&gt; PasswordCategory\nFileStorageImpl ..|&gt; FileStorage\nStorageAdapter ..|&gt; StorageImplementation\nStorageAPI ..|&gt; StorageImplementation\nPasswordManagerMemento ..|&gt; MementoOriginator\n\nStorageAPI *-- StorageAdapter : contains\nStorageAPI o-- PasswordManagerCaretaker : uses &gt;\nStorageAPI ..&gt; PasswordManagerMemento : creates &gt;\n\nStorageAdapter *-- FileStorage : uses\nStorageAdapter *-- Encryptor : uses\nStorageAdapter o-- \&quot;1\&quot; Category : contains\nStorageAdapter o-- \&quot;*\&quot; Passwords : manages\n\nFactoryPassword ..&gt; Strong : creates &gt;\nFactoryPassword ..&gt; Standart : creates &gt;\n\nStrong --&gt; PasswordGenerator : uses\nStandart --&gt; PasswordGenerator : uses\n\nStrong --&gt; ReusablePool : uses\nStandart --&gt; ReusablePool : uses\nCategory --&gt; ReusablePool : uses\nPasswordGenerator --&gt; ReusablePool : uses\n\nPasswordManagerCaretaker o-- \&quot;*\&quot; PasswordManagerMemento : stores\n\nMain --&gt; StorageAPI : uses\nMain ..&gt; FactoryPassword : uses\n\nAppInstance ..&gt; ConfigurationSingleton : uses\nConfigurationSingleton ..&gt; ConfigurationManager : creates\n\nMain --&gt; AppInstance : initializes &gt;\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="TAQO7KC3a_Kqlcrcfuz9-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
